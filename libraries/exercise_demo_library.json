{
  "wall_push_up": {
    "exercise_name": "靠墙俯卧撑",
    "instructions": [
      "面向墙站好，双手扶墙。",
      "屈肘靠近墙，再推回。",
      "身体保持直线。"
    ],
    "default_beat_hz": 0.35
  },
  "arm_circles": {
    "exercise_name": "手臂绕环",
    "instructions": [
      "双臂平展。",
      "摆动双臂画小圈。",
      "肩膀放松。"
    ],
    "default_beat_hz": 0.8
  },
  "standing_punches": {
    "exercise_name": "站姿出拳",
    "instructions": [
      "双脚开立与肩同宽。",
      "双手握拳置于胸前。",
      "左右交替向前出拳。"
    ],
    "default_beat_hz": 1.0
  },
  "bodyweight_squat": {
    "exercise_name": "深蹲",
    "instructions": [
      "双脚开立与肩同宽。",
      "臀部向后坐，慢慢下蹲。",
      "注意膝盖对准脚尖。"
    ],
    "default_beat_hz": 0.4
  },
  "standing_knee_raise": {
    "exercise_name": "站姿提膝",
    "instructions": [
      "自然站立。",
      "左右膝盖交替抬高。",
      "上半身保持稳定，感受腹部发力。"
    ],
    "default_beat_hz": 0.8
  },
  "calf_raise": {
    "exercise_name": "提踵",
    "instructions": [
      "双脚开立与肩同宽。",
      "脚跟慢慢抬起。",
      "平稳落回，感受小腿发力。"
    ],
    "default_beat_hz": 0.6
  },
  "standing_knee_to_elbow": {
    "exercise_name": "提膝转体",
    "instructions": [
      "双手轻放头两侧。",
      "抬膝，同时转动上身，膝盖触碰另一侧手肘。",
      "左右交替完成。"
    ],
    "default_beat_hz": 0.7
  },
  "standing_reverse_fly": {
    "exercise_name": "双臂开合扩背",
    "instructions": [
      "双臂抬至在胸前，微曲。",
      "向两侧打开，感受背部发力。",
      "收回胸前，肩膀放松。"
    ],
    "default_beat_hz": 0.5
  },
  "standing_y_raise": {
    "exercise_name": "双臂斜上举",
    "instructions": [
      "自然站立，双臂向前平举。",
      "向斜上方抬起成Y字形。",
      "肩膀放松，慢慢回位。"
    ],
    "default_beat_hz": 0.5
  },
  "standing_back_clap": {
    "exercise_name": "背部拍手",
    "instructions": [
      "自然站立，双臂平举。",
      "双臂向下摆动，手在背后拍手。",
      "肩膀放松，感受背部发力。"
    ],
    "default_beat_hz": 0.5
  },
  "step_jack": {
    "exercise_name": "开合步",
    "instructions": [
      "自然站立，双手下垂。",
      "一脚向侧面迈步，同时双臂向上打开。",
      "把脚收回，同时双臂放下。另一侧重复。"
    ],
    "default_beat_hz": 0.85
  },
  "jumping_jacks": {
    "exercise_name": "开合跳",
    "instructions": [
      "自然站立，双手下垂。",
      "跳起，打开双脚，同时手臂上挥。",
      "双脚跳回，同时手臂回落，保持节奏。"
    ],
    "default_beat_hz": 1.2
  }
}
